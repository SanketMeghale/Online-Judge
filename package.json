{
  "name": "online-judge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "judge-service"
  ],
  "scripts": {
    "build": "npm --workspace apps/web run build",
    "build:web": "npm --workspace apps/web run build",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:realtime": "npm --workspace services/realtime run dev",
    "dev:judge": "npm --workspace judge-service run dev",
    "start:api": "npm --workspace apps/api run start",
    "preview:web": "npm --workspace apps/web run preview",
    "test:api": "npm --workspace apps/api test",
    "test:judge": "npm --workspace judge-service test --",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "dependencies": {}
}
