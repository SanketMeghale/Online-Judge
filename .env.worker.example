NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/online-judge
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
ALLOW_INSECURE_REDIS=false
SANDBOX_IMAGE=online-judge-sandbox:latest
EXECUTION_SERVICE_TOKEN=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=https://judgo.example
REALTIME_JWT_SECRET=replace-with-a-different-32-character-secret
WORKER_ID=judgo-worker-01
WORKER_CONCURRENCY=2
WORKER_RATE_LIMIT_MAX=60
JOB_MAX_ATTEMPTS=3
JOB_LOCK_DURATION_MS=120000
MAX_EXECUTION_TIME_MS=3000
MAX_COMPILATION_TIME_MS=15000
MAX_MEMORY_MB=256
MAX_OUTPUT_BYTES=524288
JUDGE_TEMP_ROOT=/var/lib/judgo/jobs
MONITORING_PORT=4002
LOG_DIR=/var/log/judgo
REALTIME_SERVICE_URL=
REALTIME_INTERNAL_SECRET=replace-with-another-32-character-secret
