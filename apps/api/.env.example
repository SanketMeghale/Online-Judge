# =====================================================
# Online Judge API - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=4000
NODE_ENV=development

# --- MongoDB Atlas ---
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/online-judge?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters

# --- CORS ---
CLIENT_ORIGIN=http://localhost:8080

# --- Firebase token verification (required for Google/GitHub sign-in) ---
FIREBASE_PROJECT_ID=your-firebase-project-id

# Development-only demo users. Never enable in production.
ENABLE_DEMO_USERS=false

# Shared only between the API/judge workers and realtime service.
REALTIME_INTERNAL_SECRET=generate-a-separate-random-service-secret
REALTIME_JWT_SECRET=generate-a-separate-random-realtime-jwt-secret
REALTIME_SERVICE_URL=http://localhost:4001

# --- Redis / BullMQ (required for all code execution) ---
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_MS=1000

# --- Abuse and resource limits ---
SUBMISSION_RATE_LIMIT_PER_MINUTE=15
RUN_CODE_RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_JOBS_PER_USER=3
MAX_SOURCE_SIZE_BYTES=100000
MAX_CUSTOM_INPUT_SIZE_BYTES=64000
MAX_EXECUTION_TIME_MS=3000
MAX_COMPILATION_TIME_MS=15000
MAX_MEMORY_MB=256
MAX_OUTPUT_BYTES=524288
WORKER_CONCURRENCY=2

# --- Execution worker monitoring (server-to-server only) ---
EXECUTION_SERVICE_URL=http://localhost:4002
EXECUTION_SERVICE_TOKEN=generate-a-separate-execution-service-token
