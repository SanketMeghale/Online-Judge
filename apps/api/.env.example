# =====================================================
# Online Judge API - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=4000
NODE_ENV=development

# --- MongoDB Atlas ---
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/online-judge?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=judgo-super-secret-jwt-key-2025-do-not-share

# --- CORS ---
CLIENT_ORIGIN=http://localhost:8080

# --- RabbitMQ (optional) ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Judge0 (optional) ---
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# RAPIDAPI_KEY=your-rapidapi-key-here
