NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/online-judge?retryWrites=true&w=majority
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
ALLOW_INSECURE_REDIS=false
JWT_SECRET=replace-with-at-least-32-random-characters
REALTIME_JWT_SECRET=replace-with-a-different-32-character-secret
REALTIME_INTERNAL_SECRET=replace-with-another-32-character-secret
REALTIME_SERVICE_URL=https://realtime.example.com
VITE_REALTIME_URL=https://realtime.example.com
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
CLIENT_ORIGIN=https://online-judge-api-six.vercel.app
ENABLE_DEMO_USERS=false
